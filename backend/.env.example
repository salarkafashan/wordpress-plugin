APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Toronto
APP_BASE_URL=https://support.example.com
APP_NAME=Agency Support System
APP_KEY=change-this-to-a-random-64-char-string

DB_PATH=database/support.sqlite

WHMCS_API_BASE_URL=https://kgr360.com
WHMCS_API_KEY=site-a
WHMCS_API_TOKEN=change-me
WHMCS_BYPASS_LOCAL=false

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=change-me
JIRA_API_USER=api-bot@example.com
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Task
JIRA_WEBHOOK_SECRET=change-me
JIRA_NOTIFY_STATUSES=Done,Client Review

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASS=change-me
SMTP_FROM=support@example.com
SMTP_FROM_NAME=Agency Support
EMAIL_LOGO_URL=https://via.placeholder.com/160x48?text=Kanguru+Logo

ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com
ADMIN_USER=admin
ADMIN_PASS=change-me

RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=20

CAPTCHA_PROVIDER=cloudflare
CAPTCHA_ENFORCE_PREVIEW=false
CAPTCHA_VERIFY_TIMEOUT=10

CLOUDFLARE_TURNSTILE_SITE_KEY=change-me
CLOUDFLARE_TURNSTILE_SECRET_KEY=change-me

GOOGLE_RECAPTCHA_SITE_KEY=change-me
GOOGLE_RECAPTCHA_SECRET_KEY=change-me
GOOGLE_RECAPTCHA_MIN_SCORE=0.5
GOOGLE_RECAPTCHA_EXPECTED_ACTION=support_submit

HONEYPOT_ENABLED=true
HONEYPOT_FIELD_NAME=company_website
HONEYPOT_MIN_SECONDS=2
HONEYPOT_MAX_SECONDS=7200

STORAGE_PATH=storage
ATTACHMENT_RETENTION_MONTHS=3

MAX_UPLOAD_MB=5
UPLOAD_PATH=uploads
LOG_PATH=logs/app.log
